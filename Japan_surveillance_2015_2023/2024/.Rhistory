outsim <- rbind(outsim, df)
}
}
}
require("deSolve")
require("doBy")
require("pals")
seirmod = function(t, startconds, parms) {
S = startconds[1]
E = startconds[2]
I = startconds[3]
R = startconds[4]
mu = parms["mu"]
beta = parms["beta"]
sigma = parms["sigma"]
gamma = parms["gamma"]
omega = parms["omega"]
controlstart = parms["controlstart"]
controlend = parms["controlend"]
betared = parms["betared"]
# beta
if(t >= controlstart & t <= controlend){
beta = (1 - betared)*beta
}
dS = mu * (1 - S) - beta * S * I + omega*R
dE = beta * S * I - (mu + sigma) * E
dI = sigma * E - (mu + gamma) * I
dR = gamma * I - mu * R - omega*R
res = c(dS, dE, dI, dR)
list(res)
}
controlstartuse = 90
controlenduse = 92
betareduse = 0.5
durImmvec <- seq(0.01,30,length = 10)
betavec <- seq(600, 1200, length = 10)
betaredvec <- seq(0.3,0.7,length = 10)
outsim <- NULL
for(i in 1:length(durImmvec)){
for(j in 1:length(betavec)){
for(k in 1:length(betaredvec)){
omegause = 1/durImmvec[i]
times = seq(0, 100, by = 1/52)
parms = c(mu = 1/50, beta = betavec[j], sigma = 365/8, gamma = 365/5, omega = omegause, controlstart = controlstartuse,
controlend = controlenduse, betared = betaredvec[k])
startconds = c(S = 0.06, E = 0, I = 0.001, R = 0.939)
out2 = as.data.frame(ode(startconds, times, seirmod, parms))
out2 <- out2[out2$time >= 80,]
plot(out2$time, out2$I, type = "l", col=parula(9)[5], bty = "n", ylab =
"", xlab = "", lwd = 2)
title(xlab="Time (years)", line = 2)
title(ylab="I/N", line = 2)
abline(v = controlstartuse)
abline(v = controlenduse)
df <- data.frame(time = out2$time[out2$time >= 84 & out2$time <95], cases = out2$I[out2$time >= 84 & out2$time <95],
susceptibles = out2$S[out2$time >= 84 & out2$time <95])
plot(df$cases, df$susceptibles, type = "l")
r0calc <- betavec[j]/(1/durrImmvec[i] + 365/5)
df$year <- floor(df$time)
outsums<- summaryBy(cases ~ year, FUN = c(sum,max), data = df, na.rm = TRUE)
df = data.frame(omega = omegause, durrim = durImmvec[i],betared = betaredvec[k], R0 = r0calc, betause = betavec[j], meansumpre = mean(outsums$cases.sum[1:6]),
meansumpost = sum(outsums$cases.sum[7:11])/5, maxsumpost = max(outsums$cases.sum[7:11]),   meanmaxpre = mean(outsums$cases.max[1:6]),
maxpost = max(outsums$cases.max[7:11]) )
df$relsum = df$meansumpost/df$meansumpre
df$relsummax = df$maxsumpost/df$meansumpre
outsim <- rbind(outsim, df)
}
}
}
